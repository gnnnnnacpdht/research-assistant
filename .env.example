# 后端允许跨域访问的前端地址
FRONTEND_ORIGIN=http://localhost:3000

# 前端访问 FastAPI 的基础地址
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 后续接入模型时填写；当前健康检查无需密钥
DEEPSEEK_API_KEY=sk-xxxx
SILICONFLOW_API_KEY=sk-xxxx
MULTIMODAL_API_KEY=

# 以下为 RAG 问答模块的可选配置，不填使用括号内默认值
# CHAT_MODEL=deepseek-chat
# EMBEDDING_MODEL=BAAI/bge-m3
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RETRIEVE_TOP_K=5
# RERANK_TOP_K=3
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
# 中文提问是否先改写成英文检索式（1 开启）
# QUERY_REWRITE=1

# 扫描件 OCR（多模态模型）；MULTIMODAL_API_KEY 留空则复用 SILICONFLOW_API_KEY
# MULTIMODAL_API_KEY=
# VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
# OCR_MIN_CHARS=50
# OCR_DPI=150
# OCR_CONCURRENCY=4
